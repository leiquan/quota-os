+/* 沿调用链走到真正要跑的那个任务（v015 起可以是 调用者 -> 服务端 A -> 服务端 B）。 */
+static struct task *chain_end(struct task *t)
+{
+    for (int n = 0; n < 8 && t->state == TASK_IPC; n++) {
+        struct task *s = t->server;
+        if (!s || s->caller != t)
+            return 0;
+        t = s;
+    }
+    return t->state == TASK_READY ? t : 0;
